  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Assets\nHouse, Barn, and Well made by me using Blender 3.5 \nVolumetric
    fog and Mist 2 by Kronnect\nFence from lowpoly barriers pack schatro dev assets
    \nPickup truck Padia 3D\nRealistic terrain textures by ALP\nEuropean forest by
    Mysticforge\nBen Cloward on youtube for pixelation filter\nBlender Default Cube
    on youtube for low poly cow\nPixxo 3d on youtube for character modeling\nPoint
    Grass Renderer Micah Wilder \nModular First Person Controller by Jecase \nTools
    by Donopardo\nMetal Rack by DigitalHakka \nPickup item by Gunzz on youtube\nItem
    rotate by Tarodev on youtube\nRed eyes on cow in chase scene was suggested by
    matt cribb\nFlashlight by Stupidazzle on youtube\nLadder by romullus on sketchfab\nPallet
    by marsy on sketchfab\nChurch podium by max_sukhin on sketchfab\nTextures\nTextures
    for the house were found on ambientcg.com and polyhaven.com \nTextures for well
    were found on polyhaven.com \nMusic\nTitle screen: Dark Resonance by SamuelFJohanns
    from pixabay.com"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
